# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Where plan files get saved (can be absolute or relative)
PLANS_BASE_FOLDER=./plans

# Google Sheets spreadsheet ID (the long ID in the URL)
# Example: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
SPREADSHEET_ID=your_spreadsheet_id

# Optional: route the LLM classifier/chat through a custom OpenAI-compatible
# endpoint (e.g. Hugging Face Inference Endpoints) instead of Groq.
# Leave QWEN_BASE_URL empty to keep using Groq.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL_NAME=
